// Prisma schema for NutriFlexs - Neon PostgreSQL Compatible

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  TRAINER
  KITCHEN
  ADMIN
}

enum OrderStatus {
  ORDER_PLACED
  ACCEPTED
  PREPARING
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

enum InventoryTxType {
  IN
  OUT
  ADJUSTMENT
}

enum MealType {
  BREAKFAST
  LUNCH
  SNACKS
  DINNER
}

model User {
  id               String         @id @default(uuid())
  name             String
  email            String         @unique
  passwordHash     String?
  role             Role           @default(CUSTOMER)
  avatar           String?
  phone            String?
  selectedGymId    String?
  selectedOutletId String?
  streakDays       Int            @default(12)
  proteinGoalGrams         Int            @default(120)
  weightKg                 Float?
  customDailyProteinGoal   Int?
  isVegetarian             Boolean        @default(false)
  createdAt                DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  orders           Order[]
  subscriptions    Subscription[]
  trainerProfile   Trainer?
  referralsMade    Referral[]     @relation("CustomerReferrals")

  selectedGym      Gym?           @relation(fields: [selectedGymId], references: [id])
  selectedOutlet   Outlet?        @relation(fields: [selectedOutletId], references: [id])
  createdStaffAccessCodes StaffAccessCode[] @relation("CreatedAccessCodes")
  nutritionGoal    NutritionGoal?
  foodLogs         FoodLog[]
  customFoods      FoodItem[]     @relation("CustomFoodItems")
  favoriteFoods    FavoriteFood[]
  savedMeals       SavedMeal[]
}

model Gym {
  id             String   @id @default(uuid())
  name           String
  address        String
  city           String
  area           String?
  imageUrl       String?
  phone          String?
  operatingHours String?  @default("6:00 AM – 10:00 PM")
  latitude       Float?
  longitude      Float?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  outlets   Outlet[]
  users     User[]

  @@index([city, isActive])
  @@index([name])
}

model Outlet {
  id             String   @id @default(uuid())
  name           String
  gymId          String
  address        String
  phone          String?
  operatingHours String?  @default("6:00 AM – 10:00 PM")
  latitude       Float?
  longitude      Float?
  isAvailable    Boolean  @default(true)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  gym            Gym             @relation(fields: [gymId], references: [id])
  orders         Order[]
  inventoryItems InventoryItem[]
  users          User[]
  staffAccessCodes StaffAccessCode[]

  @@index([gymId, isAvailable])
}

model Trainer {
  id                String   @id @default(uuid())
  userId            String   @unique
  referralCode      String   @unique
  totalReferrals    Int      @default(0)
  activeSubscribers Int      @default(0)
  rewardsEarned     Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  referrals         Referral[]      @relation("TrainerReferrals")
  rewards           TrainerReward[]
  orders            Order[]
}

model Category {
  id           String    @id @default(uuid())
  name         String    @unique
  slug         String    @unique
  description  String?
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  products     Product[]
}

model Product {
  id                     String              @id @default(uuid())
  name                   String
  slug                   String              @unique
  description            String
  price                  Float
  calories               Int
  protein                Float
  carbs                  Float
  fats                   Float
  preparationTimeMinutes Int                 @default(3)
  imageUrl               String
  categoryId             String
  isAvailable            Boolean             @default(true)
  isFeatured             Boolean             @default(false)
  isPopular              Boolean             @default(false)
  isVeg                  Boolean             @default(true)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  category               Category            @relation(fields: [categoryId], references: [id])
  ingredients            ProductIngredient[]
  orderItems             OrderItem[]
  foodLogs               FoodLog[]
  favoriteFoods          FavoriteFood[]
  savedMealItems         SavedMealItem[]

  @@index([categoryId, isAvailable])
  @@index([isPopular, isAvailable])
  @@index([isFeatured, isAvailable])
}

model Ingredient {
  id        String   @id @default(uuid())
  name      String   @unique
  isOrganic Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productIngredients ProductIngredient[]
  inventoryItems     InventoryItem[]
}

model ProductIngredient {
  id           String @id @default(uuid())
  productId    String
  ingredientId String
  amount       String?

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([productId, ingredientId])
}

model Order {
  id                   String        @id @default(uuid())
  orderNumber          String        @unique
  userId               String
  outletId             String
  status               OrderStatus   @default(ORDER_PLACED)
  subtotal             Float
  discount             Float         @default(0)
  totalAmount          Float
  totalProtein         Float         @default(0)
  totalCalories        Int           @default(0)
  paymentStatus        PaymentStatus @default(PENDING)
  trainerId            String?
  couponId             String?
  estimatedPrepMinutes Int           @default(3)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  user       User        @relation(fields: [userId], references: [id])
  outlet     Outlet      @relation(fields: [outletId], references: [id])
  trainer    Trainer?    @relation(fields: [trainerId], references: [id])
  coupon     Coupon?     @relation(fields: [couponId], references: [id])
  items      OrderItem[]
  payment    Payment?

  @@index([userId, createdAt])
  @@index([outletId, status])
  @@index([createdAt])
}

model OrderItem {
  id              String   @id @default(uuid())
  orderId         String
  productId       String
  quantity        Int
  priceAtPurchase Float
  productJson     String?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  foodLogs FoodLog[]

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String        @unique
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  amount            Float
  status            PaymentStatus @default(PENDING)
  method            String        @default("RAZORPAY")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model SubscriptionPlan {
  id           String   @id @default(uuid())
  name         String
  price        Float
  validityDays Int      @default(30)
  creditsCount Int      @default(30)
  description  String
  benefits     String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id               String             @id @default(uuid())
  userId           String
  planId           String
  remainingCredits Int
  startDate        DateTime           @default(now())
  endDate          DateTime
  status           SubscriptionStatus @default(ACTIVE)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user User             @relation(fields: [userId], references: [id])
  plan SubscriptionPlan @relation(fields: [planId], references: [id])
}

model Referral {
  id              String   @id @default(uuid())
  trainerId       String
  customerId      String
  codeUsed        String
  discountApplied Float    @default(0)
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())

  trainer  Trainer @relation("TrainerReferrals", fields: [trainerId], references: [id])
  customer User    @relation("CustomerReferrals", fields: [customerId], references: [id])
}

model TrainerReward {
  id          String    @id @default(uuid())
  trainerId   String
  rewardTitle String
  isClaimed   Boolean   @default(false)
  claimedAt   DateTime?
  createdAt   DateTime  @default(now())

  trainer Trainer @relation(fields: [trainerId], references: [id])
}

model Coupon {
  id             String       @id @default(uuid())
  code           String       @unique
  discountType   DiscountType @default(PERCENTAGE)
  discountValue  Float
  minOrderAmount Float        @default(0)
  maxDiscount    Float?
  validUntil     DateTime?
  usageLimit     Int?
  usageCount     Int          @default(0)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  orders Order[]
}

model InventoryItem {
  id                String   @id @default(uuid())
  outletId          String
  ingredientId      String
  quantity          Float
  unit              String   @default("kg")
  lowStockThreshold Float    @default(5)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  outlet       Outlet                 @relation(fields: [outletId], references: [id])
  ingredient   Ingredient             @relation(fields: [ingredientId], references: [id])
  transactions InventoryTransaction[]

  @@unique([outletId, ingredientId])
}

model InventoryTransaction {
  id              String          @id @default(uuid())
  inventoryItemId String
  type            InventoryTxType
  amount          Float
  reason          String?
  createdAt       DateTime        @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
}

model StaffAccessCode {
  id          String    @id @default(uuid())
  codeHash    String    @unique
  codePrefix  String?
  role        Role
  outletId    String?
  isActive    Boolean   @default(true)
  expiresAt   DateTime?
  maxUses     Int       @default(1)
  usedCount   Int       @default(0)
  description String?
  isDevSeed   Boolean   @default(false)
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  outlet    Outlet? @relation(fields: [outletId], references: [id], onDelete: SetNull)
  createdBy User?   @relation("CreatedAccessCodes", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([role, isActive])
  @@index([codeHash])
}

model FoodItem {
  id                 String   @id @default(uuid())
  name               String
  description        String?
  category           String
  caloriesPer100g    Float    @default(0)
  protein            Float    @default(0)
  carbohydrates      Float    @default(0)
  fat                Float    @default(0)
  defaultServingSize Float    @default(100)
  defaultServingUnit String   @default("g")
  servingWeightGrams Float?   @default(100)
  isCustom           Boolean  @default(false)
  createdById        String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  createdBy User?           @relation("CustomFoodItems", fields: [createdById], references: [id], onDelete: SetNull)
  foodLogs  FoodLog[]
  favoriteFoods FavoriteFood[]
  savedMealItems SavedMealItem[]

  @@index([name])
  @@index([category, isActive])
  @@index([isCustom, createdById])
}

model FoodLog {
  id               String   @id @default(uuid())
  userId           String
  foodItemId       String?
  orderItemId      String?
  productId        String?
  foodNameSnapshot String
  mealType         MealType
  quantity         Float
  unit             String
  calories         Float
  protein          Float
  carbohydrates    Float
  fat              Float
  loggedAt         DateTime @default(now())
  dateKey          String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodItem  FoodItem?  @relation(fields: [foodItemId], references: [id], onDelete: SetNull)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  product   Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([userId, dateKey])
  @@index([userId, mealType, dateKey])
  @@index([orderItemId])
}

model NutritionGoal {
  id               String   @id @default(uuid())
  userId           String   @unique
  dailyCalorieGoal Int?
  proteinGoal      Float?
  carbohydrateGoal Float?
  fatGoal          Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BlogPost {
  id              String   @id @default(uuid())
  title           String
  slug            String   @unique
  excerpt         String
  content         String   @db.Text
  coverImage      String
  category        String
  authorName      String   @default("NutriFlexs Nutrition Team")
  authorRole      String?  @default("Sports Nutritionist")
  authorAvatar    String?
  readTimeMinutes Int      @default(4)
  isFeatured      Boolean  @default(false)
  isPublished     Boolean  @default(true)
  publishedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tags            String[] @default([])

  @@index([slug])
  @@index([category, isPublished])
  @@index([publishedAt])
}

model FavoriteFood {
  id                 String   @id @default(uuid())
  userId             String
  foodItemId         String?
  productId          String?
  foodNameSnapshot   String
  category           String?
  caloriesPer100g    Float    @default(0)
  protein            Float    @default(0)
  carbohydrates      Float    @default(0)
  fat                Float    @default(0)
  defaultServingSize Float    @default(1)
  defaultServingUnit String   @default("serving")
  servingWeightGrams Float?   @default(100)
  createdAt          DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodItem FoodItem? @relation(fields: [foodItemId], references: [id], onDelete: Cascade)
  product  Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([foodItemId])
  @@index([productId])
}

model SavedMeal {
  id          String          @id @default(uuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items SavedMealItem[]

  @@index([userId])
}

model SavedMealItem {
  id                 String   @id @default(uuid())
  savedMealId        String
  foodItemId         String?
  productId          String?
  foodName           String
  quantity           Float
  unit               String
  calories           Float
  protein            Float
  carbohydrates      Float
  fat                Float
  caloriesPer100g    Float?   @default(0)
  servingWeightGrams Float?   @default(100)

  savedMeal SavedMeal @relation(fields: [savedMealId], references: [id], onDelete: Cascade)
  foodItem  FoodItem? @relation(fields: [foodItemId], references: [id], onDelete: SetNull)
  product   Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([savedMealId])
}

